@using Microsoft.AspNetCore.Identity
@using RuteaYa.Entidades
@inject UserManager<Usuario> UserManager
@{
    var usuario = await UserManager.GetUserAsync(User);
    var nombreCompleto = usuario is null ? "" : $"{usuario.Nombre} {usuario.Apellido}";

    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();

    // cambiar estos a medida que vayamos avanzando con los controladores, esta a modo de suposicion
    var items = new (string Texto, string Controlador)[]
    {
        ("Inicio", "Home"),
        ("Mis viajes", "Viajes"),
        ("Mis envíos", "Envios"),
        ("Oportunidades", "Oportunidades"),
        ("Optimizador", "Optimizador"),
        ("Mis transportes", "Transportes"),
        ("Historial", "Historial")
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RuteaYa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script>
        (function () {
            var guardado = localStorage.getItem("tema");
            var sistemaClaro = window.matchMedia("(prefers-color-scheme: light)").matches;
            document.documentElement.setAttribute("data-theme", guardado || (sistemaClaro ? "light" : "dark"));
        })();
    </script>
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <a class="sidebar__brand" asp-controller="Home" asp-action="Index">RuteaYa</a>

            <nav class="sidebar__nav">
                @foreach (var item in items)
                {
                    var activo = item.Controlador == controladorActual;
                    <a class="sidebar__link @(activo ? "is-active" : "")"
                       asp-controller="@item.Controlador" asp-action="Index">@item.Texto</a>
                }
            </nav>

            <div class="sidebar__user">
                <div>
                    <span class="sidebar__name">@nombreCompleto</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="link-btn">Cerrar sesión</button>
                    </form>
                </div>
                <button type="button" id="tema-toggle" class="theme-btn" aria-label="Cambiar tema">◐</button>
            </div>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>