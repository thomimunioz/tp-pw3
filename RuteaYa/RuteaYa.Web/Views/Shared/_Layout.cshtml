@using Microsoft.AspNetCore.Identity
@using RuteaYa.Entidades
@inject UserManager<Usuario> UserManager
@{
    var usuario = await UserManager.GetUserAsync(User);
    var nombreCompleto = usuario is null ? "" : $"{usuario.Nombre} {usuario.Apellido}";
    var iniciales = usuario is null ? "" : $"{usuario.Nombre.FirstOrDefault()}{usuario.Apellido.FirstOrDefault()}".ToUpper();

    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();

    var items = new (string Texto, string Controlador, string Icono)[]
    {
        ("Inicio", "Home", "home"),
        ("Mis viajes", "Viajes", "map"),
        ("Mis envíos", "Envios", "package"),
        ("Oportunidades", "Oportunidades", "sparkles"),
        ("Optimizador", "Optimizador", "sliders"),
        ("Mis transportes", "Transportes", "truck"),
        ("Historial", "Historial", "history")
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RuteaYa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tema.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script src="~/js/layout.js" asp-append-version="true"></script>
</head>
<body>
    <partial name="_Iconos" />

    <header class="topbar">
        <a class="marca" asp-controller="Home" asp-action="Index">
            <span class="marca__logo"><svg class="icono"><use href="#i-navigation" /></svg></span>
            RuteaYa
        </a>
        <button type="button" id="menu-toggle" class="btn-icono" aria-label="Abrir menú"
                aria-controls="menu-lateral" aria-expanded="false">
            <svg class="icono"><use href="#i-menu" /></svg>
        </button>
    </header>

    <div class="fondo-menu" id="menu-fondo"></div>

    <div class="app">
        <aside class="sidebar" id="menu-lateral">
            <div>
                <div class="sidebar__head">
                    <a class="marca" asp-controller="Home" asp-action="Index">
                        <span class="marca__logo"><svg class="icono"><use href="#i-navigation" /></svg></span>
                        RuteaYa
                    </a>
                    <button type="button" id="tema-toggle" class="btn-icono" aria-label="Cambiar tema" title="Cambiar tema">
                        <svg class="icono icono-sol"><use href="#i-sun" /></svg>
                        <svg class="icono icono-luna"><use href="#i-moon" /></svg>
                    </button>
                </div>

                <nav class="sidebar__nav">
                    @foreach (var item in items)
                    {
                        var activo = item.Controlador == controladorActual;
                        <a class="sidebar__link @(activo ? "is-active" : "")"
                           asp-controller="@item.Controlador" asp-action="Index">
                            <svg class="icono"><use href="#i-@item.Icono" /></svg>
                            <span>@item.Texto</span>
                        </a>
                    }
                </nav>
            </div>

            <div class="sidebar__user">
                <div class="avatar">@iniciales</div>
                <div class="sidebar__datos">
                    <span class="sidebar__name">@nombreCompleto</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn-salir">
                            <svg class="icono"><use href="#i-logout" /></svg>
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            </div>
        </aside>

        <main class="content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>