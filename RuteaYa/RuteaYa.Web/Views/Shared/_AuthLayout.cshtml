<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RuteaYa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <main class="auth">
        <section class="auth__hero">
            <span class="auth__brand">RuteaYa</span>

            <img class="auth__ilustracion" src="~/img/auth-ciudad.svg" alt="" />

            <div class="auth__claim">
                <h1>Convertí tus viajes habituales en una oportunidad.</h1>
                <p>Compartí el espacio libre de tus recorridos y ganá dinero llevando paquetes.</p>
            </div>
        </section>

        <section class="auth__panel">
            <div class="auth__card">
                @RenderBody()
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>