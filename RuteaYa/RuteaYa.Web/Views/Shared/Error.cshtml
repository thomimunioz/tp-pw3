@model ErrorViewModel
@{
    ViewData["Title"] = "Algo salió mal";
}

<div class="pagina-error">
    <div class="pagina-error__icono">
        <svg class="icono"><use href="#i-navigation" /></svg>
    </div>

    <h1>Algo salió mal</h1>
    <p>Tuvimos un problema al procesar tu pedido. Probá de nuevo en unos minutos.</p>

    <a class="pagina-error__boton" asp-controller="Home" asp-action="Index">Volver al inicio</a>

    @if (Model.ShowRequestId)
    {
        <p class="pagina-error__codigo">Código del error: @Model.RequestId</p>
    }
</div>
