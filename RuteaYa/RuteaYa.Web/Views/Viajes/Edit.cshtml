@model RuteaYa.Web.Models.ViajeEditarViewModel

@{
    ViewData["Title"] = "Editar viaje";
}

<div class="form-tarjeta">
    <div class="form-tarjeta__encabezado">
        <svg class="icono"><use href="#i-navigation" /></svg>
        <h1>Editar viaje</h1>
        <a asp-action="Index" class="form-tarjeta__cerrar" aria-label="Cerrar">
            <svg class="icono"><use href="#i-x" /></svg>
        </a>
    </div>
    <p class="form-tarjeta__subtitulo">Modificá los datos de tu recorrido habitual.</p>

    <form asp-action="Edit" method="post" class="form-envio" data-form-viaje>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-campo">
            <label asp-for="OrigenDir">Origen</label>
            <input asp-for="OrigenDir" placeholder="¿Desde dónde salís?" autocomplete="off" data-lugares-url="@Url.Action("Sugerir", "Lugares")" />
            <span asp-validation-for="OrigenDir"></span>
        </div>

        <div class="form-campo">
            <label asp-for="DestinoDir">Destino</label>
            <input asp-for="DestinoDir" placeholder="¿A dónde llegás?" autocomplete="off" data-lugares-url="@Url.Action("Sugerir", "Lugares")" />
            <span asp-validation-for="DestinoDir"></span>
        </div>

        <div class="form-campo">
            <div class="paradas-editor__encabezado">
                <label class="mb-0">Paradas intermedias <span>(opcional)</span></label>
                <button type="button" class="btn-parada" data-agregar-parada>+ Agregar parada</button>
            </div>
            <p class="paradas-editor__ayuda">Agregá las paradas en el orden en que vas a realizarlas. Podés cambiarlo con las flechas.</p>
            <div class="paradas-editor" data-paradas-editor data-lugares-url="@Url.Action("Sugerir", "Lugares")">
                @if (Model.ParadasIntermedias != null && Model.ParadasIntermedias.Any())
                {
                    @for (var i = 0; i < Model.ParadasIntermedias.Count; i++)
                    {
                        <div class="parada-item">
                            <span class="parada-item__numero">@(i + 1)</span>
                            <input name="ParadasIntermedias[@i]" value="@Model.ParadasIntermedias[i]" placeholder="Dirección de la parada" autocomplete="off" data-lugares-url="@Url.Action("Sugerir", "Lugares")" />
                            <div class="parada-item__acciones">
                                <button type="button" class="btn-parada btn-parada--icono" data-subir-parada aria-label="Subir parada" title="Subir">↑</button>
                                <button type="button" class="btn-parada btn-parada--icono" data-bajar-parada aria-label="Bajar parada" title="Bajar">↓</button>
                                <button type="button" class="btn-parada btn-parada--eliminar" data-eliminar-parada aria-label="Eliminar parada" title="Eliminar">×</button>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="parada-item">
                        <span class="parada-item__numero">1</span>
                        <input name="ParadasIntermedias[0]" placeholder="Dirección de la parada" autocomplete="off" data-lugares-url="@Url.Action("Sugerir", "Lugares")" />
                        <div class="parada-item__acciones">
                            <button type="button" class="btn-parada btn-parada--icono" data-subir-parada aria-label="Subir parada" title="Subir" disabled>↑</button>
                            <button type="button" class="btn-parada btn-parada--icono" data-bajar-parada aria-label="Bajar parada" title="Bajar" disabled>↓</button>
                            <button type="button" class="btn-parada btn-parada--eliminar" data-eliminar-parada aria-label="Eliminar parada" title="Eliminar">×</button>
                        </div>
                    </div>
                }
            </div>
            <span asp-validation-for="ParadasIntermedias" class="text-danger"></span>
        </div>
        <div class="form-campo">
            <label>Días de la semana</label>
            <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; padding: 0.5Rem 0;">
                @foreach (var dia in new[]
                {
                    new { Value = 1, Label = "L" },
                    new { Value = 2, Label = "M" },
                    new { Value = 3, Label = "X" },
                    new { Value = 4, Label = "J" },
                    new { Value = 5, Label = "V" },
                    new { Value = 6, Label = "S" },
                    new { Value = 0, Label = "D" }
                })
                {
                    <label class="tamano-chip" style="display: inline-flex; align-items: center; gap: 0.3rem; padding: 0.4rem 0.8rem; cursor: pointer;">
                        <input type="checkbox"
                               name="DiasSeleccionados"
                               value="@dia.Value"
                               id="dia-@dia.Value"
                        @(Model.DiasSeleccionados != null && Model.DiasSeleccionados.Contains(dia.Value) ? "checked" : null) />
                        <span>@dia.Label</span>
                    </label>
                }
            </div>
            <span asp-validation-for="DiasSeleccionados"></span>
        </div>

        <div class="form-fila form-fila--horarios">
            <div class="form-campo">
                <label asp-for="HoraSalida">Hora de salida</label>
                <input asp-for="HoraSalida" type="time" />
                <span asp-validation-for="HoraSalida"></span>
            </div>
            <div class="form-campo">
                <label asp-for="HoraLlegada">Hora de llegada</label>
                <input asp-for="HoraLlegada" type="time" />
                <span asp-validation-for="HoraLlegada"></span>
            </div>
        </div>

        <div class="form-fila">
            <div class="form-campo">
                <label asp-for="MaxPaquetes">Máximo de paquetes</label>
                <input asp-for="MaxPaquetes" type="number" min="1" />
                <span asp-validation-for="MaxPaquetes"></span>
            </div>
            <div class="form-campo">
                <label asp-for="PesoMaxKg">Peso máximo (kg)</label>
                <input asp-for="PesoMaxKg" type="number" step="0.01" min="0.1" />
                <span asp-validation-for="PesoMaxKg"></span>
            </div>
        </div>

        <div class="form-campo">
            <label asp-for="DesvioMaxKm">Desvío máximo (km)</label>
            <input asp-for="DesvioMaxKm" type="number" step="0.01" min="0" />
            <span asp-validation-for="DesvioMaxKm"></span>
        </div>

        <div class="form-acciones" style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1.5rem;">
            <a asp-action="Index" class="btn-form btn-form--secundario" style="text-decoration: none; text-align: center;">Cancelar</a>
            <button type="submit" class="btn-form btn-form--primario">Guardar cambios</button>
        </div>
    </form>
</div>

@section Estilos {
    <link rel="stylesheet" href="~/css/envios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lugares.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/viajes.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/lugares.js" asp-append-version="true"></script>
    <script src="~/js/viajes-form.js" asp-append-version="true"></script>
}