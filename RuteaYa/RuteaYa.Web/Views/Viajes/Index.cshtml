@model List<RuteaYa.Entidades.Viaje>

@{
    ViewData["Title"] = "Mis viajes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Mis viajes</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo viaje</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info border-0 rounded-3 shadow-sm">
        No tenés viajes cargados.
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-borderless align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Origen</th>
                            <th>Destino</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var viaje in Model)
                        {
                            <tr>
                                <td>@viaje.OrigenDir</td>
                                <td>@viaje.DestinoDir</td>
                                <td>
                                    @if (viaje.Activo)
                                    {
                                        <span class="badge bg-success rounded-pill">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">Ver</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}






























































































































































































