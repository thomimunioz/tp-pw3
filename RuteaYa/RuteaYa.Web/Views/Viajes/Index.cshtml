@model List<RuteaYa.Entidades.Viaje>

@{
    ViewData["Title"] = "Mis viajes";
}

<div class="pagina">
    <div class="envios-header">
        <div>
            <h1>Mis viajes</h1>
            <p>Tus recorridos habituales.</p>
        </div>
        <a asp-action="Create" class="btn-form btn-form--primario viajes-nuevo">
            <svg class="icono"><use href="#i-plus" /></svg>
            Nuevo viaje
        </a>
    </div>

    @if (TempData["MensajeExito"] is string mensaje)
    {
        <div class="alerta alerta-exito" role="status">@mensaje</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="detalle-card viajes-vacio">
            <p>No tenés viajes cargados.</p>
        </div>
    }
    else
    {
        <div class="viajes-lista">
            @foreach (var viaje in Model)
            {
                <article class="detalle-card viaje-fila">
                    <div class="viaje-fila__ruta">
                        <strong>@viaje.OrigenDir <span aria-hidden="true">→</span> @viaje.DestinoDir</strong>
                        <span class="viaje-fila__estado">
                            Estado: <span class="estado @(viaje.Activo ? "estado-entregado" : "estado-cancelado")">@(viaje.Activo ? "Activo" : "Inactivo")</span>
                        </span>
                    </div>

                    <div class="viaje-fila__acciones">
                        <a asp-action="Detalle" asp-route-id="@viaje.Id" class="btn-form btn-form--secundario">Ver</a>
                        
                        @if (viaje.Activo)
                        {
                            <a asp-action="Edit" asp-route-id="@viaje.Id" class="btn-form btn-form--secundario">Editar</a>
                            <a asp-controller="Oportunidades" asp-action="Index" asp-route-viajeId="@viaje.Id" class="btn-form btn-form--secundario">Oportunidades</a>
                            <form asp-action="Desactivar" asp-route-id="@viaje.Id" method="post"
                                  onsubmit="return confirm('¿Seguro que querés desactivar este viaje? Dejará de aparecer como disponible para nuevas oportunidades.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn-form btn-form--peligro">Desactivar</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@section Estilos {
    <link rel="stylesheet" href="~/css/envios.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/viajes.css" asp-append-version="true" />
}
