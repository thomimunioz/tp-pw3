@{
    ViewData["Title"] = "Página no encontrada";
}

<div class="pagina-404">
    <svg class="pagina-404__mapa" viewBox="0 0 320 140" aria-hidden="true">
        <path class="pagina-404__ruta" d="M20 110 C 80 110, 90 40, 150 40 S 230 100, 280 62" />
        <circle class="pagina-404__inicio" cx="20" cy="110" r="7" />
        <g class="pagina-404__pin" transform="translate(280 62)">
            <path d="M0 -24 C -10 -24 -15 -16 -15 -9 C -15 2 0 14 0 14 C 0 14 15 2 15 -9 C 15 -16 10 -24 0 -24 Z" />
            <circle cx="0" cy="-9" r="5" />
        </g>
    </svg>

    <p class="pagina-404__codigo">404</p>
    <h1>Recalculando…</h1>
    <p>Esta página no existe o todavía está en construcción.</p>

    <div class="pagina-404__acciones">
        <a class="pagina-404__boton" asp-controller="Home" asp-action="Index">Volver al inicio</a>
        <button type="button" class="pagina-404__boton pagina-404__boton--secundario" onclick="history.back()">Ir atrás</button>
    </div>
</div>
