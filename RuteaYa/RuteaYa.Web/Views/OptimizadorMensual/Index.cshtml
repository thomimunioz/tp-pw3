@model RuteaYa.Logica.Optimizacion.ProyeccionMensualDto
@using System.Globalization
@using RuteaYa.Logica.Optimizacion
@{
    ViewData["Title"] = "Optimizador mensual";
    var ar = CultureInfo.GetCultureInfo("es-AR");
    var mesInput = Model.Mes.ToString("yyyy-MM", CultureInfo.InvariantCulture);
    var viajesConPaquetes = Model.Viajes
        .Where(v => v.Envios.Count > 0)
        .ToList();
    var hoy = DateOnly.FromDateTime(DateTime.Today);

    // "viernes 20/11" -> "Viernes 20/11"
    string Dia(DateOnly fecha)
    {
        var texto = fecha.ToString("dddd dd/MM", ar);
        return char.ToUpper(texto[0]) + texto.Substring(1);
    }

    string IdViaje(ProyeccionViajeDto viaje) => "viaje-" + viaje.ViajeId + "-" + viaje.Fecha.ToString("yyyyMMdd");

    string CriterioNombre(CriterioOptimizacion criterio) => criterio switch
    {
        CriterioOptimizacion.MinimizarDesvios => "Minimizar desvíos",
        CriterioOptimizacion.Equilibrio => "Equilibrio",
        _ => "Maximizar ganancias"
    };
}

<div class="proyeccion">
    <header class="cabecera cabecera--fila">
        <div>
            <h1>Optimizador de ganancias mensual</h1>
            <p>Proyectá las ganancias potenciales de tus viajes recurrentes y los envíos disponibles.</p>
        </div>
    </header>

    @if (TempData["Error"] is string error)
    {
        <div class="aviso aviso--error" role="alert">@error</div>
    }

    <form class="proyeccion__filtros panel" method="get" asp-action="Index">
        <div>
            <label class="selector__etiqueta" for="mes">Mes</label>
            <input class="selector__select" id="mes" name="mes" type="month"
                   value="@mesInput"
                   min="@DateTime.Today.ToString("yyyy-MM", CultureInfo.InvariantCulture)" />
        </div>
        <div>
            <label class="selector__etiqueta" for="criterio">Criterio</label>
            <select class="selector__select" id="criterio" name="criterio">
                @foreach (var criterio in Enum.GetValues<CriterioOptimizacion>())
                {
                    <option value="@criterio" selected="@(criterio == Model.Criterio)">
                        @CriterioNombre(criterio)
                    </option>
                }
            </select>
        </div>
        <button class="btn btn--primario" type="submit">Actualizar proyección</button>
    </form>

    <p class="proyeccion__aviso">
        Los importes son estimaciones potenciales, no ganancias efectivamente obtenidas.
        Solo se consideran viajes futuros y envíos compatibles aún disponibles.
    </p>

    <section class="proyeccion__metricas">
        <article class="panel proyeccion__metrica proyeccion__metrica--destacada">
            <span>Ganancia potencial del mes</span>
            <strong>@Model.GananciaPotencial.ToString("C0", ar)</strong>
        </article>
        <article class="panel proyeccion__metrica">
            <span>Viajes analizados</span>
            <strong>@Model.ViajesAnalizados</strong>
        </article>
        <article class="panel proyeccion__metrica">
            <span>Promedio potencial por viaje</span>
            <strong>@Model.PromedioPorViaje.ToString("C0", ar)</strong>
        </article>
        <article class="panel proyeccion__metrica">
            <span>Paquetes compatibles</span>
            <strong>@Model.PaquetesPosibles</strong>
        </article>
    </section>

    <section class="panel">
        <div class="proyeccion__titulo">
            <div>
                <h2>Ganancia potencial por semana</h2>
                <p>Criterio aplicado: @CriterioNombre(Model.Criterio)</p>
            </div>
        </div>
        <div class="proyeccion__semanas">
            @foreach (var semana in Model.Semanas)
            {
                // Las semanas que ya pasaron no se proyectan: se muestran apagadas en vez de "$ 0"
                var pasada = semana.Hasta < hoy;
                var conGanancia = semana.GananciaPotencial > 0;
                <div class="proyeccion__semana @(conGanancia && !pasada ? "proyeccion__semana--ganancia" : "proyeccion__semana--apagada")">
                    <span>@(semana.Desde == semana.Hasta ? semana.Desde.ToString("dd/MM") : semana.Desde.ToString("dd/MM") + " – " + semana.Hasta.ToString("dd/MM"))</span>
                    @if (pasada)
                    {
                        <strong>Ya pasó</strong>
                    }
                    else if (!conGanancia)
                    {
                        <strong>Sin envíos</strong>
                    }
                    else
                    {
                        <strong>@semana.GananciaPotencial.ToString("C0", ar)</strong>
                    }
                </div>
            }
        </div>
    </section>

    @if (Model.MejorRecorrido is { } mejor)
    {
        <section class="panel proyeccion__mejor">
            <div class="proyeccion__titulo">
                <div>
                    <h2>Mejor recorrido del mes</h2>
                    <p><strong>@Dia(mejor.Fecha)</strong> · @mejor.Origen → @mejor.Destino</p>
                    <p class="proyeccion__detalle">
                        @mejor.Envios.Count paquete(s) · desvío total @mejor.DesvioTotalKm.ToString("0.0", ar) km ·
                        <a href="#@IdViaje(mejor)">Ver los paquetes</a>
                    </p>
                </div>
                <strong>@mejor.GananciaPotencial.ToString("C0", ar)</strong>
            </div>
        </section>
    }
    else
    {
        <section class="vacio">
            <strong>No hay paquetes compatibles para este mes</strong>
            <span>Se analizaron @Model.ViajesAnalizados viajes recurrentes. Probá con otro mes o criterio.</span>
        </section>
    }

    <section class="panel">
        <div class="proyeccion__titulo">
            <div>
                <h2>Viajes con paquetes compatibles</h2>
                <p>
                    Se muestran @viajesConPaquetes.Count de @Model.ViajesAnalizados viajes analizados.
                    Los paquetes se asignan como máximo a un viaje en toda la proyección.
                </p>
            </div>
        </div>
        @if (viajesConPaquetes.Count == 0)
        {
            @if (Model.ViajesAnalizados == 0)
            {
                <p class="nota">No hay viajes recurrentes futuros en el período seleccionado.</p>
            }
            else
            {
                <p class="nota">Se analizaron @Model.ViajesAnalizados viajes, pero ninguno tiene paquetes compatibles seleccionados.</p>
            }
        }
        else
        {
            <ul class="proyeccion__viajes">
                @foreach (var viaje in viajesConPaquetes)
                {
                    var esMejor = Model.MejorRecorrido != null
                        && viaje.ViajeId == Model.MejorRecorrido.ViajeId
                        && viaje.Fecha == Model.MejorRecorrido.Fecha;
                    <li id="@IdViaje(viaje)" class="proyeccion__viaje @(esMejor ? "proyeccion__viaje--mejor" : "")">
                        <div class="proyeccion__viaje-cabecera">
                            <div>
                                <div class="proyeccion__viaje-fecha">
                                    <strong>@Dia(viaje.Fecha)</strong>
                                    @if (esMejor)
                                    {
                                        <span class="proyeccion__chip">Mejor recorrido</span>
                                    }
                                </div>
                                <span>@viaje.Origen → @viaje.Destino · @viaje.Envios.Count paquete(s) · desvío total @viaje.DesvioTotalKm.ToString("0.0", ar) km</span>
                            </div>
                            <strong class="proyeccion__monto">@viaje.GananciaPotencial.ToString("C0", ar)</strong>
                        </div>
                        <ul class="proyeccion__paquetes">
                            @foreach (var envio in viaje.Envios)
                            {
                                <li>
                                    <span class="proyeccion__paquete">
                                        <strong>@envio.Descripcion</strong>
                                        <span>@envio.Ruta</span>
                                    </span>
                                    <span class="proyeccion__paquete-datos">@envio.PesoKg.ToString("0.##", ar) kg · desvío @envio.DesvioKm.ToString("0.0", ar) km</span>
                                    <span class="proyeccion__paquete-monto">@envio.Ganancia.ToString("C0", ar)</span>
                                </li>
                            }
                        </ul>
                    </li>
                }
            </ul>
        }
    </section>
</div>

@section Estilos {
    <link rel="stylesheet" href="~/css/oportunidades.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/proyeccion-mensual.css" asp-append-version="true" />
}
