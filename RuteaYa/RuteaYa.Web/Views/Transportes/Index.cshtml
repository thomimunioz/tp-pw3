@using RuteaYa.Entidades.Enums
@using RuteaYa.Logica.Transportes.Dtos
@model List<TransporteListadoDto>

@{
    ViewData["Title"] = "Mis transportes";
}

<div class="transportes-container">
    <header class="transportes-header">
        <h1>Mis transportes</h1>
        <p>Paquetes que aceptaste llevar.</p>
    </header>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alerta-exito">
            <span>✅</span>
            <span>@TempData["MensajeExito"]</span>
        </div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alerta-error">
            <span>⚠️</span>
            <span>@TempData["MensajeError"]</span>
        </div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="transportes-vacio">
            <div class="vacio-icono">📦</div>
            <h3>No tenés transportes asignadosSSSSS todavía</h3>
            <p>Cuando aceptes paquetes compatibles con tus viajes, van a aparecer acá para que puedas gestionar su entrega.</p>
            <a asp-controller="Viajes" asp-action="Index" class="btn-secundario">Ver mis viajes</a>
        </div>
    }
    else
    {
        <div class="transportes-lista">
            @foreach (var item in Model)
            {
                <div class="transporte-card @(item.Finalizado() ? "is-finalizado" : "")">
                    
                    <!-- Info principal del paquete. -->
                    <div class="transporte-info">
                        <div class="transporte-titulo-fila">
                            <h3 class="transporte-titulo">@item.PaqueteDescripcion</h3>
                            <span class="badge-ganancia">+@item.Ganancia.ToString("C0")</span>
                        </div>
                        <p class="transporte-ruta"> 📍 @item.PaqueteOrigen &rarr; @item.PaqueteDestino</p>
                        <div class="transporte-meta">
                            <span>🚗 Viaje: @item.ViajeOrigen &rarr; @item.ViajeDestino</span>
                            <span>•</span>
                            <span>📅 @item.FechaViaje.ToString("dd/MM/yyyy")</span>
                            <span>•</span>
                            <span>⚖️ @item.PesoKg kg</span>
                        </div>
                    </div>

                    <!-- Estado y botón de acción. -->
                    <div class="transporte-acciones">
                        
                        <!-- Badge de estado. -->
                        <span class="badge-estado badge-@item.Estado.ToString().ToLower()">
                            @FormatearEstado(item.Estado)
                        </span>

                        <!-- Botón dinámico según el estado. -->
                        @if (item.PuedeMarcarRetirado())
                        {
                            <form asp-action="MarcarRetirado" method="post">
                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                <button type="submit" class="btn-accion btn-retirar">Marcar retirado</button>
                            </form>
                        }
                        else if (item.PuedeMarcarEnCamino())
                        {
                            <form asp-action="MarcarEnCamino" method="post">
                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                <button type="submit" class="btn-accion btn-camino">Marcar en camino</button>
                            </form>
                        }
                        else if (item.PuedeMarcarEntregado())
                        {
                            <form asp-action="MarcarEntregado" method="post">
                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                <button type="submit" class="btn-accion btn-entregar">Marcar entregado</button>
                            </form>
                        }
                        else if (item.Estado == EstadoEnvio.Entregado)
                        {
                            <span class="texto-completado">Completado ✓</span>
                        }
                    </div>w
                </div>
            }
        </div>
    }
</div>

@functions {
    public static string FormatearEstado(EstadoEnvio estado)
    {
        return estado switch
        {
            EstadoEnvio.BuscandoConductor => "Buscando conductor",
            EstadoEnvio.ConductorAsignado => "Conductor asignado",
            EstadoEnvio.Retirado => "Retirado",
            EstadoEnvio.EnCamino => "En camino",
            EstadoEnvio.Entregado => "Entregado",
            EstadoEnvio.Cancelado => "Cancelado",
            _ => estado.ToString()
        };
    }
}

<style>
    .transportes-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .transportes-header {
        margin-bottom: 2rem;
    }

    .transportes-header h1 {
        font-size: 2rem;
        margin: 0 0 0.35rem;
        font-weight: 700;
    }

    .transportes-header p {
        color: var(--text-muted);
        margin: 0;
    }

    .alerta-exito, .alerta-error {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.85rem 1.25rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
    }

    .alerta-exito {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        border: 1px solid rgba(34, 197, 94, 0.3);
    }

    .alerta-error {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.3);
    }

    .transportes-lista {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .transporte-card {
        background: var(--bg-panel);
        border: 1px solid var(--input-border);
        border-radius: 14px;
        padding: 1.25rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        transition: border-color 0.15s ease;
    }

    .transporte-card:hover {
        border-color: var(--text-muted);
    }

    .transporte-card.is-finalizado {
        opacity: 0.75;
    }

    .transporte-info {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        min-width: 0;
    }

    .transporte-titulo-fila {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .transporte-titulo {
        font-size: 1.15rem;
        font-weight: 700;
        margin: 0;
    }

    .badge-ganancia {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.2rem 0.55rem;
        border-radius: 6px;
    }

    .transporte-ruta {
        margin: 0;
        color: var(--text);
        font-size: 0.95rem;
    }

    .transporte-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        color: var(--text-muted);
        font-size: 0.82rem;
    }

    .transporte-acciones {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0;
    }

    .badge-estado {
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .badge-conductorasignado {
        background: rgba(234, 179, 8, 0.15);
        color: #eab308;
    }

    .badge-retirado {
        background: rgba(59, 130, 246, 0.15);
        color: #3b82f6;
    }

    .badge-encamino {
        background: rgba(168, 85, 247, 0.15);
        color: #a855f7;
    }

    .badge-entregado {
        background: rgba(34, 197, 94, 0.15);
        color: #22c55e;
    }

    .badge-cancelado {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
    }

    .btn-accion {
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        border: none;
        white-space: nowrap;
        transition: transform 0.1s ease, filter 0.15s ease;
    }

    .btn-accion:hover {
        transform: translateY(-1px);
        filter: brightness(1.1);
    }

    .btn-retirar {
        background: #3b82f6;
        color: #ffffff;
    }

    .btn-camino {
        background: #0f1a33;
        color: #ffffff;
        border: 1px solid #1f2d50;
    }

    [data-theme="dark"] .btn-camino {
        background: #ffffff;
        color: #0b1220;
    }

    .btn-entregar {
        background: #22c55e;
        color: #ffffff;
    }

    .texto-completado {
        font-size: 0.9rem;
        font-weight: 700;
        color: #22c55e;
    }

    .transportes-vacio {
        text-align: center;
        padding: 4rem 2rem;
        border: 1px dashed var(--input-border);
        border-radius: 16px;
    }

    .vacio-icono {
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    .transportes-vacio h3 {
        margin: 0 0 0.5rem;
    }

    .transportes-vacio p {
        color: var(--text-muted);
        max-width: 420px;
        margin: 0 auto 1.5rem;
        font-size: 0.95rem;
    }

    .btn-secundario {
        display: inline-block;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        background: var(--hover);
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
    }

    @@media (max-width: 768px) {
        .transporte-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .transporte-acciones {
            width: 100%;
            justify-content: space-between;
        }
    }
</style>