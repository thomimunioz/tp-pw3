@using RuteaYa.Entidades.Enums
@using RuteaYa.Logica.Transportes.Dtos
@model List<TransporteListadoDto>

@{
    ViewData["Title"] = "Mis transportes";
    var hoy = DateOnly.FromDateTime(DateTime.Today);
}

<div class="transportes-container">
    <header class="transportes-header">
        <div>
            <h1>Mis transportes</h1>
            <p>Paquetes que aceptaste y todavía tenés que llevar.</p>
        </div>
        <a asp-controller="Historial" asp-action="Index" class="link-historial">Ver entregados y cancelados en Historial &rarr;</a>
    </header>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alerta-exito">@TempData["MensajeExito"]</div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alerta-error">@TempData["MensajeError"]</div>
    }

    @if (Model == null || Model.Count == 0)
    {
        <div class="transportes-vacio">
            <h3>No tenés paquetes para llevar</h3>
            <p>Cuando aceptes un envío desde Oportunidades, va a aparecer acá para que vayas marcando cada paso hasta entregarlo.</p>
            <a asp-controller="Oportunidades" asp-action="Index" class="btn-secundario">Buscar oportunidades</a>
        </div>
    }
    else
    {
        <p class="transportes-cantidad">@(Model.Count == 1 ? "Tenés 1 paquete para llevar." : $"Tenés {Model.Count} paquetes para llevar.")</p>

        <div class="transportes-lista">
            @foreach (var item in Model)
            {
                <article class="transporte-card estado-@item.Estado.ToString().ToLower()">

                    <div class="transporte-info">
                        <div class="transporte-titulo-fila">
                            <h3 class="transporte-titulo">@item.PaqueteDescripcion</h3>
                            <span class="badge-estado">@FormatearEstado(item.Estado)</span>
                        </div>
                        <p class="transporte-ruta">@item.PaqueteOrigen &rarr; @item.PaqueteDestino</p>
                        <p class="transporte-meta">
                            Tu viaje @item.ViajeOrigen &rarr; @item.ViajeDestino del @item.FechaViaje.ToString("dd/MM/yyyy")
                            @if (item.FechaViaje == hoy)
                            {
                                <span class="chip-hoy">Hoy</span>
                            }
                            <span aria-hidden="true">·</span> @item.PesoKg.ToString("0.##") kg
                        </p>
                    </div>

                    <div class="transporte-ganancia">+@item.Ganancia.ToString("C0")</div>

                    <div class="transporte-accion">
                        @if (item.PuedeMarcarRetirado() && item.FechaViaje > hoy)
                        {
                            <span class="texto-espera">Lo retirás el @item.FechaViaje.ToString("dd/MM")</span>
                        }
                        else if (item.PuedeMarcarRetirado())
                        {
                            <form asp-action="MarcarRetirado" method="post">
                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                <button type="submit" class="btn-accion btn-retirar">Marcar retirado</button>
                            </form>
                        }
                        else if (item.PuedeMarcarEnCamino())
                        {
                            <form asp-action="MarcarEnCamino" method="post">
                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                <button type="submit" class="btn-accion btn-camino">Marcar en camino</button>
                            </form>
                        }
                        else if (item.PuedeMarcarEntregado())
                        {
                            <form asp-action="MarcarEntregado" method="post"
                                  data-confirmar="¿Confirmás que entregaste @item.PaqueteDescripcion en @item.PaqueteDestino? Después no se puede deshacer.">
                                <input type="hidden" name="envioId" value="@item.EnvioId" />
                                <button type="submit" class="btn-accion btn-entregar">Marcar entregado</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@functions {
    public static string FormatearEstado(EstadoEnvio estado)
    {
        return estado switch
        {
            EstadoEnvio.BuscandoConductor => "Buscando conductor",
            EstadoEnvio.ConductorAsignado => "Para retirar",
            EstadoEnvio.Retirado => "Retirado",
            EstadoEnvio.EnCamino => "En camino",
            EstadoEnvio.Entregado => "Entregado",
            EstadoEnvio.Cancelado => "Cancelado por el remitente",
            _ => estado.ToString()
        };
    }
}

@section Scripts {
    <script>
        // Pide confirmación antes de marcar como entregado (no se puede deshacer)
        document.querySelectorAll("form[data-confirmar]").forEach(function (form) {
            form.addEventListener("submit", function (evento) {
                if (!window.confirm(form.dataset.confirmar)) {
                    evento.preventDefault();
                }
            });
        });
    </script>
}

<style>
    .transportes-container {
        max-width: 960px;
        margin: 0 auto;
    }

    .transportes-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: flex-end;
        gap: 0.75rem 1.5rem;
        margin-bottom: 1.5rem;
    }

    .link-historial {
        color: var(--accent);
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
    }

    .link-historial:hover {
        text-decoration: underline;
    }

    .transportes-cantidad {
        margin: 0 0 0.75rem;
        color: var(--text-muted);
        font-size: 0.95rem;
    }

    .chip-hoy {
        display: inline-block;
        margin-left: 0.35rem;
        padding: 0.05rem 0.5rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--accent);
        background: color-mix(in srgb, var(--accent) 14%, transparent);
    }

    .texto-espera {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-muted);
        text-align: right;
    }

    .transportes-header h1 {
        font-size: 2rem;
        margin: 0 0 0.35rem;
        font-weight: 700;
    }

    .transportes-header p {
        color: var(--text-muted);
        margin: 0;
    }

    .alerta-exito, .alerta-error {
        padding: 0.85rem 1.25rem;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        font-size: 0.95rem;
    }

    .alerta-exito {
        background: color-mix(in srgb, var(--estado-ok) 12%, transparent);
        color: var(--estado-ok);
        border: 1px solid color-mix(in srgb, var(--estado-ok) 35%, transparent);
    }

    .alerta-error {
        background: color-mix(in srgb, var(--estado-cancelado) 12%, transparent);
        color: var(--estado-cancelado);
        border: 1px solid color-mix(in srgb, var(--estado-cancelado) 35%, transparent);
    }

    .transportes-lista {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    /* Cada tarjeta: paquete | ganancia | acción. El color del borde izquierdo es el del estado. */
    .transporte-card {
        --c: var(--text-muted);
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto 12rem;
        align-items: center;
        gap: 1.5rem;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-left: 4px solid var(--c);
        border-radius: 12px;
        padding: 1rem 1.25rem;
    }

    .estado-conductorasignado { --c: var(--estado-asignado); }
    .estado-retirado,
    .estado-encamino { --c: var(--estado-curso); }

    .transporte-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        min-width: 0;
    }

    .transporte-titulo-fila {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6rem;
    }

    .transporte-titulo {
        font-size: 1.05rem;
        font-weight: 700;
        margin: 0;
    }

    .badge-estado {
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        white-space: nowrap;
        color: var(--c);
        background: color-mix(in srgb, var(--c) 14%, transparent);
    }

    .transporte-ruta {
        margin: 0;
        font-size: 0.95rem;
    }

    .transporte-meta {
        margin: 0;
        font-size: 0.82rem;
        color: var(--text-muted);
    }

    .transporte-ganancia {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--estado-ok);
        white-space: nowrap;
    }

    .transporte-accion {
        display: flex;
        justify-content: flex-end;
    }

    .transporte-accion form {
        width: 100%;
    }

    .btn-accion {
        width: 100%;
        padding: 0.6rem 1rem;
        border-radius: 10px;
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        border: none;
        white-space: nowrap;
        color: #ffffff;
    }

    .btn-accion:hover {
        filter: brightness(1.1);
    }

    .btn-retirar {
        background: var(--estado-asignado);
    }

    .btn-camino {
        background: var(--estado-curso);
    }

    .btn-entregar {
        background: var(--estado-ok);
    }


    .transportes-vacio {
        text-align: center;
        padding: 4rem 2rem;
        border: 1px dashed var(--border);
        border-radius: 16px;
    }

    .transportes-vacio h3 {
        margin: 0 0 0.5rem;
    }

    .transportes-vacio p {
        color: var(--text-muted);
        max-width: 420px;
        margin: 0 auto 1.5rem;
        font-size: 0.95rem;
    }

    .btn-secundario {
        display: inline-block;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        background: var(--hover);
        color: var(--text);
        text-decoration: none;
        font-weight: 700;
        font-size: 0.9rem;
    }

    @@media (max-width: 768px) {
        .transporte-card {
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 0.75rem 1rem;
        }

        .transporte-accion {
            grid-column: 1 / -1;
        }

        .texto-espera {
            text-align: left;
        }
    }
</style>
