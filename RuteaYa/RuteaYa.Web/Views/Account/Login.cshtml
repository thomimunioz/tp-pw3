@model RuteaYa.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Ingresar";
    Layout = "_AuthLayout";
}

<h2>Ingresar</h2>

<form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
    <div asp-validation-summary="ModelOnly"></div>

    <div class="campo">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" placeholder="tu@email.com" autocomplete="email" />
        <span asp-validation-for="Email"></span>
    </div>

    <div class="campo">
        <label asp-for="Password">Contraseña</label>
        <input asp-for="Password" autocomplete="current-password" />
        <span asp-validation-for="Password"></span>
    </div>

    <div class="recordarme">
        <input asp-for="Recordarme" />
        <label asp-for="Recordarme">Recordarme</label>
    </div>

    <button type="submit" class="boton">Ingresar</button>

    <p class="auth__alternativa">
        ¿Todavía no tenés una cuenta? <a asp-action="Registro">Crear cuenta</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}